# 复制为 .env 后按需修改；与 docker-compose.yml 放在同一目录。
# 生成随机密钥：openssl rand -hex 32

# 必填：JWT 签名密钥，至少 32 字节（更换后旧 token 全部失效）
JWT_SECRET=
# 必填：MySQL root 密码（首次启动用它初始化数据库）
DB_PASSWORD=

# 对外访问端口（前端页面与 /api 都走这个端口）
WEB_PORT=80

# 镜像：GitHub Actions 推到 ghcr.io/<github 用户名小写>/scaffold-backend 与 scaffold-frontend
# IMAGE_TAG 可用 latest、分支名、git 短 sha 或版本标签（如 v1.0.0）
BACKEND_IMAGE=ghcr.io/nightyuyyy/scaffold-backend
FRONTEND_IMAGE=ghcr.io/nightyuyyy/scaffold-frontend
IMAGE_TAG=latest

# 可选
DB_NAME=scaffold_system
DB_TIMEZONE=+08:00
TZ=Asia/Shanghai
REDIS_PASSWORD=
JWT_EXPIRES_SECONDS=7200
# 后端启动时执行初始化 SQL（建表 + 种子数据，幂等）；库已就绪后可改为 false
DB_AUTO_INIT=true
